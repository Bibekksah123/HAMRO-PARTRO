{
  "name": "merodin",
  "private": true,
  "packageManager": "bun@1.3.8",
  "engines": {
    "node": ">=20.9.0",
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --env-file=.env run turbo run dev --filter=@merodin/web",
    "build": "bun --env-file=.env run turbo run build",
    "start": "bun --env-file=.env run --cwd apps/web start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "bun test",
    "test:e2e": "bun --env-file=.env run playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@next/eslint-plugin-next": "^16.3.6",
    "@playwright/test": "^1.63.0",
    "bun-types": "^1.3.8",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.10.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
